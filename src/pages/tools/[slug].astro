---
import Base from '../../layouts/Base.astro';
import Lettering from '../../components/Lettering.astro';
import Comments from '../../components/Comments.astro';
import { TOOLS, SLIDES, zoneOf, sessionLabel } from '../../data/toolkit.js';
import { SHOW_SLIDE_LINKS } from '../../config.js';

export function getStaticPaths() {
  return TOOLS.map((tool, i) => ({ params: { slug: tool.slug }, props: { tool, prev: TOOLS[i - 1] ?? null, next: TOOLS[i + 1] ?? null } }));
}

const { tool, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const zone = zoneOf(tool);
const deckId = typeof tool.session === 'number' ? SLIDES[tool.session] : SLIDES[String(tool.session).split('–')[0]];
const slidesUrl = deckId ? `https://docs.google.com/presentation/d/${deckId}/copy` : null;
const showSlides = SHOW_SLIDE_LINKS && slidesUrl;
const titleHeight = tool.name.length > 16 ? 80 : 110;
---
<Base title={tool.name} description={tool.what}>
  <nav class="wrap crumbs" aria-label="Breadcrumb">
    <a href={base}>Toolkit</a><span aria-hidden="true">/</span>
    <a href={`${base}#${zone.slug}`}>Zone 0{zone.num} {zone.name}</a><span aria-hidden="true">/</span>
    <span>{tool.name}</span>
  </nav>

  <section class="hero" style="padding-top: 56px">
    <span class="doodle felt"><img src={`${base}doodles/${zone.slug}.svg`} alt="" /></span>
    <Lettering text={tool.name.replace(/[’,?]/g, (c) => (c === '’' ? "'" : ''))} height={titleHeight} label={tool.name} maxWidth="100%" />
    <p class="sub">Zone 0{zone.num} {zone.name} | {tool.time} | {sessionLabel(tool.session)}</p>
    <p class="lede" style="margin-top: 8px">{tool.intro}</p>
  </section>

  <section class="wrap" style="padding-bottom: 64px">
    <div class="spread">
      <div class="panel panel-grey" style="flex: 3 1 520px">
        {tool.evidenceCard ? (
          <div class="ev-card felt">
            <div class="felt-rb"><span class="lbl">We heard</span><p>______ told us that ______________.</p></div>
            <div class="felt-b"><span class="lbl">We saw</span><p>____________________________.</p></div>
            <div class="felt-r think"><span class="lbl">We think</span><p>Someone may need a way to ________.</p></div>
            <div><span class="lbl">We still need to ask</span><p>____________________________?</p></div>
          </div>
        ) : (
          <p style="margin: 0; font-size: 20px; line-height: 1.5">{tool.what}</p>
        )}
        <div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px">
          {showSlides ? (
            <a class="btn btn-solid" href={slidesUrl}>Make a copy of the slides</a>
          ) : (
            <span class="btn btn-solid" aria-disabled="true">Slides coming soon</span>
          )}
        </div>
      </div>
      <div class="panel panel-cream" style="flex: 2 1 340px; gap: 24px">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px">
          <p style="margin: 0; font-size: 30px; line-height: 1; font-weight: 400; white-space: pre-line">{'YOU\nNEED'}</p>
          <p class="caption" style="margin: 0; max-width: 180px; font-size: 13px; line-height: 1.35; text-align: right">{tool.group}, ages 8 to 13.</p>
        </div>
        <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; font-size: 17px; line-height: 1.4">
          {tool.materials.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap" aria-labelledby="run-h" style="padding-bottom: 64px">
    <h2 id="run-h" style="margin: 0 0 12px; font-size: 30px; font-weight: 400">How to run it</h2>
    <ol class="steps">
      {tool.steps.map(([title, body], i) => (
        <li class="felt-line">
          <span class="n">{i + 1}</span>
          <div><h3>{title}</h3><p>{body}</p></div>
        </li>
      ))}
    </ol>
    {tool.credit && (
      <p style="margin: 16px 0 0; font-size: 15px">Source: <a href={tool.credit.url}>{tool.credit.text}</a></p>
    )}
  </section>

  {tool.lookFor && (
    <section class="grid-panel look" aria-labelledby="look-h">
      <h2 id="look-h" style="margin: 0; font-size: 24px; font-weight: 400">Look for a moment when someone has to…</h2>
      <div class="pills">{tool.lookFor.map((w) => <span class="pill felt">{w}</span>)}</div>
      <p style="margin: 0; font-size: 15px">Notice what happens, not what you think the answer is.</p>
    </section>
  )}

  <section class="wrap" style="padding: 64px 24px 24px">
    <div class="spread">
      {tool.note && (
        <aside class="panel panel-pink" style="flex: 1 1 420px">
          <span style="font-size: 16px; font-weight: 400; letter-spacing: .06em; text-transform: uppercase">{tool.note.label}</span>
          <p style="margin: 0; font-size: 17px">{tool.note.text}</p>
          {tool.note.next && <p style="margin: 0; font-size: 17px; color: var(--green)"><span style="font-weight: 700">Next time:</span> {tool.note.next}</p>}
        </aside>
      )}
      <Comments term={`tool:${tool.slug}`} />
    </div>
    <nav class="prev-next" aria-label="More tools">
      {prev ? <a href={`${base}tools/${prev.slug}/`}>Previous: {prev.name}</a> : <span></span>}
      {next ? <a href={`${base}tools/${next.slug}/`}>Next: {next.name}</a> : <a href={base}>Back to the toolkit</a>}
    </nav>
  </section>
</Base>
